{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "useDefineForClassFields": true,

    // Workspace packages compile to `.ts`/`.tsx`. The editor's strict
    // typecheck (with noUncheckedIndexedAccess) would otherwise chew
    // through 1000+ TS-5-strictness issues in Excalidraw's source.
    //
    // We pre-emit .d.ts via `pnpm build:types` (tsc --noCheck) into
    // `packages/excalidraw/dist/types/{excalidraw,math,utils}/`, then
    // path-redirect every `@excalidraw/*` subpath import to those
    // declaration files. `skipLibCheck: true` (above) suppresses
    // checking their internals — exactly the contract Excalidraw's
    // published npm package had with consumers.
    //
    // Vite still imports source via the packages' `main` field, so the
    // runtime is unchanged; this redirect only affects TS resolution.
    "baseUrl": ".",
    "paths": {
      "@excalidraw/excalidraw": ["./node_modules/@excalidraw/excalidraw/dist/types/excalidraw/index.d.ts"],
      "@excalidraw/excalidraw/*": ["./node_modules/@excalidraw/excalidraw/dist/types/excalidraw/*"],
      "@excalidraw/utils": ["./node_modules/@excalidraw/excalidraw/dist/types/utils/index.d.ts"],
      "@excalidraw/utils/*": ["./node_modules/@excalidraw/excalidraw/dist/types/utils/*"],
      "@excalidraw/math": ["./node_modules/@excalidraw/excalidraw/dist/types/math/index.d.ts"],
      "@excalidraw/math/*": ["./node_modules/@excalidraw/excalidraw/dist/types/math/*"]
    }
  },
  "include": ["src"]
}
