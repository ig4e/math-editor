{
  // Declaration-emit pass. `noCheck` skips type-checking — consumers
  // (the editor) get a clean .d.ts surface, and `skipLibCheck: true` in
  // their config suppresses the same TS 5 strictness noise that
  // would otherwise surface from inside the vendored TS source.
  //
  // Vite still consumes the .ts/.tsx source via `main`; `types` in
  // package.json points to the emitted .d.ts so TS-only consumers see
  // declarations.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types"
  }
}
