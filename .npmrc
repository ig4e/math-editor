# Workspace + pnpm settings.
# - `link-workspace-packages` keeps in-repo deps as symlinks (not tarballs).
# - `prefer-workspace-packages` resolves siblings via the workspace before npm.
# - We do NOT enable `shamefully-hoist` — it was useful in A.1 to expose
#   Excalidraw's transitive deps to the editor, but it also hoisted our
#   own workspace `@excalidraw/utils` + `@excalidraw/math` to the root,
#   where the editor's strict typecheck started chewing through their
#   TS sources via Excalidraw's npm-published `.d.ts` re-exports.
#   `packages/excalidraw/package.json` now declares every transitive
#   directly, so shamefully-hoist isn't needed.
link-workspace-packages=true
prefer-workspace-packages=true
auto-install-peers=true
