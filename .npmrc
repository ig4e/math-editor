# Workspace + pnpm settings.
# - `link-workspace-packages` keeps in-repo deps as symlinks (not tarballs).
# - `prefer-workspace-packages` resolves siblings via the workspace before npm.
# - `shamefully-hoist` makes Excalidraw's transitive deps reachable from
#   apps/editor without us re-declaring each one as a direct dep. Trade-off
#   accepted: pnpm's stricter graph is nice in theory but Excalidraw's source
#   depends on its dist-bundled transitives at runtime in a few places.
link-workspace-packages=true
prefer-workspace-packages=true
shamefully-hoist=true
auto-install-peers=true
